{
  "version": 2,
  "builds": [
    {
      "src": "build/web/**",
      "use": "@vercel/static",
      "config": {
        "distDir": "build/web"
      }
    }
  ],
  "routes": [
    {
      "src": "/_flutter/(.*)",
      "dest": "/build/web/_flutter/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/build/web/assets/$1"
    },
    {
      "src": "/canvaskit/(.*)",
      "dest": "/build/web/canvaskit/$1"
    },
    {
      "src": "/icons/(.*)",
      "dest": "/build/web/icons/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/build/web/$1"
    }
  ]
}
